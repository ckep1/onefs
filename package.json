{
  "name": "onefs",
  "version": "0.7.0",
  "description": "Cross-platform file system abstraction for web, Tauri, and Capacitor",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@types/node": "^22.20.4",
    "eslint": "^10.3.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^4"
  },
  "peerDependencies": {
    "@capacitor/core": ">=6.0.0",
    "@capacitor/filesystem": ">=6.0.0",
    "@capawesome/capacitor-file-picker": ">=6.0.0",
    "@tauri-apps/api": ">=2.0.0",
    "@tauri-apps/plugin-dialog": ">=2.0.0",
    "@tauri-apps/plugin-fs": ">=2.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "rollup": "^4.60.3",
    "picomatch": "^4.0.4"
  },
  "resolutions": {
    "postcss": "^8.5.10",
    "rollup": "^4.60.3",
    "picomatch": "^4.0.4"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/filesystem": {
      "optional": true
    },
    "@capawesome/capacitor-file-picker": {
      "optional": true
    },
    "@tauri-apps/api": {
      "optional": true
    },
    "@tauri-apps/plugin-dialog": {
      "optional": true
    },
    "@tauri-apps/plugin-fs": {
      "optional": true
    }
  },
  "keywords": [
    "filesystem",
    "file-system-access",
    "tauri",
    "capacitor",
    "indexeddb",
    "cross-platform"
  ],
  "author": "ckep1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckep1/onefs.git"
  },
  "homepage": "https://github.com/ckep1/onefs#readme",
  "bugs": {
    "url": "https://github.com/ckep1/onefs/issues"
  }
}
