# Skip npm auto-install of optional peer deps. vite-plugin-dts declares
# @microsoft/api-extractor as an optional peer (only used when rollupTypes:true,
# which vite.config.ts does not set). Auto-installing it pulled a chain of
# transitive advisories (api-extractor -> ajv/lodash/minimatch/diff) into the
# dev tree for no runtime benefit. Bun already skips optional peers by default.
legacy-peer-deps=true
